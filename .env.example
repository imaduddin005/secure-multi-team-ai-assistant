# Backend and database tools read the root .env through Node's --env-file option.
# Run npm run db:local:init to create it with random local DB credentials, only if absent.
# Supply actual Supabase/Redis/AI settings locally before live acceptance.
# Never paste real values into chat. Do not commit or archive .env.

# Public browser settings. npm run env:web copies only these three settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Backend identity settings: same Supabase project; expected values, not user input.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Backend-only storage credential. Legacy service-role key OR supported secret key.
# Never use this in NEXT_PUBLIC_ configuration.
SUPABASE_SERVER_STORAGE_KEY=YOUR_SERVER_ONLY_STORAGE_KEY
SUPABASE_PRIVATE_BUCKET=team-documents

# Separate PostgreSQL role credentials. Supply real connection strings locally.
# Runtime roles must not own tables or have BYPASSRLS. Migrations use a separate role.
MIGRATION_DATABASE_URL=postgresql://app_migrator:REPLACE_ME@127.0.0.1:55432/assistant
API_DATABASE_URL=postgresql://app_api:REPLACE_ME@127.0.0.1:55432/assistant
WORKER_DATABASE_URL=postgresql://app_worker:REPLACE_ME@127.0.0.1:55432/assistant
TEST_DATABASE_URL=postgresql://app_migrator:REPLACE_ME@127.0.0.1:55433/assistant_test
TEST_API_DATABASE_URL=postgresql://app_api:REPLACE_ME@127.0.0.1:55433/assistant_test
TEST_WORKER_DATABASE_URL=postgresql://app_worker:REPLACE_ME@127.0.0.1:55433/assistant_test

# Local-only provisioning administrator; never use these URLs in the API/worker.
LOCAL_ADMIN_DATABASE_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:55432/assistant
TEST_ADMIN_DATABASE_URL=postgresql://postgres:REPLACE_ME@127.0.0.1:55433/assistant_test
LOCAL_POSTGRES_PASSWORD=REPLACE_ME
LOCAL_MIGRATOR_PASSWORD=REPLACE_ME
LOCAL_API_PASSWORD=REPLACE_ME
LOCAL_WORKER_PASSWORD=REPLACE_ME
LOCAL_TEST_POSTGRES_PASSWORD=REPLACE_ME
LOCAL_TEST_MIGRATOR_PASSWORD=REPLACE_ME
LOCAL_TEST_API_PASSWORD=REPLACE_ME
LOCAL_TEST_WORKER_PASSWORD=REPLACE_ME

# Redis: local Compose service or a Redis provider, never a browser variable.
REDIS_URL=redis://localhost:6379

# OpenAI-compatible HTTP provider. Model identifiers and dimensions must match.
# Endpoint/model/dimensions/chunker identity is immutable for current ready content.
AI_BASE_URL=https://api.openai.com/v1
# Optional separate compatible endpoints; blank values fall back to AI_BASE_URL.
# Free demo recipe (Groq answers + Gemini embeddings): docs/free-ai-setup.md.
EMBEDDING_BASE_URL=
ANSWER_BASE_URL=
EMBEDDING_MODEL=YOUR_MODEL_ID
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=YOUR_SERVER_ONLY_EMBEDDING_KEY
ANSWER_MODEL=YOUR_MODEL_ID
ANSWER_API_KEY=YOUR_SERVER_ONLY_ANSWER_KEY

# Default team quota is 1000 in SQL; admins change it through the budget API.
# The upload limit is fixed at 20 MiB in the API and private bucket.
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Optional opt-in live storage check: supply an ordinary user's token privately.
# LIVE_TEST_USER_JWT=YOUR_ORDINARY_USER_ACCESS_TOKEN
