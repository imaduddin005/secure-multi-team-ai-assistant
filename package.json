{
  "name": "secure-multi-team-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Secure team-scoped private documents and cited AI answers with auditable access and quotas",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:db": "tsc -p tsconfig.database.json",
    "predb:local:init": "npm run build:db",
    "db:local:init": "node --env-file-if-exists=.env dist/tools/database/cli.js local-init",
    "db:local:up": "docker compose up -d --wait",
    "predb:bootstrap": "npm run build:db",
    "db:bootstrap": "node --env-file-if-exists=.env dist/tools/database/cli.js bootstrap",
    "predb:migrate": "npm run build:db",
    "db:migrate": "node --env-file-if-exists=.env dist/tools/database/cli.js migrate",
    "predb:seed": "npm run build:db",
    "db:seed": "node --env-file-if-exists=.env dist/tools/database/cli.js seed",
    "predb:inspect": "npm run build:db",
    "db:inspect": "node --env-file-if-exists=.env dist/tools/database/cli.js inspect",
    "pretest:db": "npm run build:db",
    "test:db": "node --env-file-if-exists=.env node_modules/jest/bin/jest.js --config jest.database.config.cjs --runInBand",
    "db:local:stop": "docker compose stop",
    "db:native:prepare": "python tools/native-postgres.py prepare",
    "db:native:start": "python tools/native-postgres.py start",
    "db:native:stop": "python tools/native-postgres.py stop",
    "build:api": "tsc -p tsconfig.api.json",
    "api:start": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "worker:start": "node --env-file-if-exists=.env dist/apps/api/src/worker.js",
    "pretest:all": "npm run build:api",
    "test:all": "node --max-old-space-size=768 --experimental-vm-modules --env-file-if-exists=.env node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand --json --outputFile=.tmp/test-results.json",
    "preenv:web": "npm run build:api",
    "env:web": "node --env-file-if-exists=.env dist/tools/web-env.js",
    "predemo:bind": "npm run build:api",
    "demo:bind": "node --env-file-if-exists=.env dist/tools/demo-bind.js",
    "precheck:storage": "npm run build:api",
    "check:storage": "node --env-file-if-exists=.env dist/tools/check-live-storage.js",
    "web:dev": "next dev apps/web --hostname 127.0.0.1",
    "web:build": "node --max-old-space-size=1536 node_modules/next/dist/bin/next build apps/web --webpack",
    "web:start": "next start apps/web --hostname 127.0.0.1",
    "package:source": "python tools/package-source.py"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "@supabase/supabase-js": "^2.119.1",
    "@tailwindcss/postcss": "4.3.5",
    "bullmq": "^6.7.8",
    "express": "5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "next": "16.4.6",
    "pdf-parse": "^2.4.5",
    "pg": "8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/multer": "2.3.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "jest": "29.7.0",
    "supertest": "7.3.2",
    "typescript": "5.9.3"
  }
}
